{
  "name": "@armyofagents/server",
  "version": "0.2.7",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    },
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts"
  },
  "files": [
    "dist",
    "ui-dist",
    "skills"
  ],
  "scripts": {
    "dev": "tsx src/index.ts",
    "dev:watch": "cross-env AOA_MIGRATION_AUTO_APPLY=true tsx watch --ignore ../ui/node_modules --ignore ../ui/.vite --ignore ../ui/dist src/index.ts",
    "build": "tsc && node --input-type=commonjs -e \"require('node:fs').cpSync('src/onboarding-assets','dist/onboarding-assets',{recursive:true})\"",
    "clean": "rm -rf dist",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.79.0",
    "@armyofagents/adapter-claude-local": "workspace:*",
    "@armyofagents/adapter-codex-local": "workspace:*",
    "@armyofagents/adapter-cursor-local": "workspace:*",
    "@armyofagents/adapter-gemini-local": "workspace:*",
    "@armyofagents/adapter-openclaw": "workspace:*",
    "@armyofagents/adapter-opencode-local": "workspace:*",
    "@armyofagents/adapter-utils": "workspace:*",
    "@armyofagents/db": "workspace:*",
    "@armyofagents/plugin-sdk": "workspace:^",
    "@armyofagents/shared": "workspace:*",
    "@aws-sdk/client-s3": "^3.888.0",
    "@google/generative-ai": "^0.24.1",
    "@octokit/rest": "^22.0.1",
    "ajv": "^8.18.0",
    "ajv-formats": "^3.0.1",
    "better-auth": "1.4.18",
    "chokidar": "^5.0.0",
    "detect-port": "^2.1.0",
    "diff": "^9.0.0",
    "dotenv": "^17.0.1",
    "drizzle-orm": "^0.38.4",
    "embedded-postgres": "^18.1.0-beta.16",
    "express": "^5.1.0",
    "express-rate-limit": "^7",
    "helmet": "^8.1.0",
    "hermes-paperclip-adapter": "0.1.1",
    "isomorphic-dompurify": "^3.12.0",
    "mammoth": "^1.12.0",
    "multer": "^2.1.1",
    "open": "^11.0.0",
    "openai": "^6.29.0",
    "pdf-parse": "^2.4.5",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "pino-pretty": "^13.1.3",
    "ws": "^8.19.0",
    "yaml": "^2.8.3",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/diff": "^8.0.0",
    "@types/express": "^5.0.0",
    "@types/express-serve-static-core": "^5.0.0",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.6.0",
    "@types/pdf-parse": "^1.1.5",
    "@types/supertest": "^6.0.2",
    "@types/ws": "^8.18.1",
    "jszip": "^3.10.1",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vitest": "^3.0.5"
  }
}
