{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "app",
      "runtimeExecutable": "cmd",
      "runtimeArgs": [
        "/c",
        "set AOA_MIGRATION_AUTO_APPLY=true && cd server && pnpm exec tsx src\\index.ts"
      ],
      "port": 3100
    },
    {
      "name": "server",
      "runtimeExecutable": "cmd",
      "runtimeArgs": ["/c", "set AOA_MIGRATION_AUTO_APPLY=true && pnpm dev"],
      "port": 3100
    },
    {
      "name": "ui",
      "runtimeExecutable": "cmd",
      "runtimeArgs": ["/c", "pnpm", "--filter", "ui", "dev"],
      "port": 5173
    },
    {
      "name": "mock",
      "runtimeExecutable": "cmd",
      "runtimeArgs": ["/c", "pnpm", "dlx", "serve", ".superpowers", "-l", "5174"],
      "port": 5174
    },
    {
      "name": "commander-mockup",
      "runtimeExecutable": "cmd",
      "runtimeArgs": ["/c", "pnpm", "dlx", "serve", ".claude", "-l", "4788"],
      "port": 4788
    }
  ]
}
