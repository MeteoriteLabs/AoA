# Scoped line-ending pins only — no repo-wide normalization.

# The fake-claude POSIX shim is exec'd by the kernel on Linux CI; a CRLF
# checkout would corrupt the `#!/bin/sh` shebang (exec format error), making
# Commander's `which claude` lookup fail silently. Pin LF regardless of the
# checkout machine's core.autocrlf.
tests/e2e/fixtures/fake-claude/claude text eol=lf
tests/e2e/fixtures/fake-claude/fake-claude.mjs text eol=lf

# Same protection for the fake-codex POSIX shim (kernel-exec'd on Linux CI).
tests/e2e/fixtures/fake-codex/codex text eol=lf
tests/e2e/fixtures/fake-codex/fake-codex.mjs text eol=lf

# Generated Commander tool-contract artifacts (tools.json / TOOLS.md) are
# regenerated by pnpm gen:tools / gen:tools:md and drift-checked in CI
# (pr.yml verify job). Pin LF so a Windows checkout with autocrlf=true can't
# rewrite them to CRLF and make the drift check falsely fail.
packages/shared/src/generated/tools.json text eol=lf
server/src/onboarding-assets/commander/TOOLS.md text eol=lf
